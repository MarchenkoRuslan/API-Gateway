{
  "name": "coart",
  "version": "1.1.0",
  "description": "API gateway for the CoART project",
  "author": "SuperHow",
  "main": "./dist/src/server.js",
  "scripts": {
    "start": "npm run build && npm run watch",
    "build": "tsc -b && npm run lint",
    "prod": "tsc -b && node ./dist/src/server.js",
    "watch-node": "nodemon ./dist/src/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,green.bold\"  \"tsc -w\" \"npm run watch-node\"",
    "lint": "eslint -c eslint.json --parser tsconfig.json"
  },
  "license": "",
  "dependencies": {
    "axios": "^0.24.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "rxjs": "^7.4.0",
    "swagger-jsdoc": "^6.1.0",
    "swagger-ui-express": "^4.1.6",
    "symbol-hd-wallets": "^0.14.1",
    "symbol-sdk": "^2.0.6",
    "typescript": "^4.5.4"
  },
  "overrides": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/bip32": "^1.0.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^20.5.9",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "concurrently": "^6.4.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.3.0",
    "nodemon": "^2.0.15"
  }
}
