{
    "compilerOptions": {
        "target": "es6", 
        "module": "commonjs",
        "lib": ["es2015", "es2016", "dom", "es2017", "es6", "es5"],
        "esModuleInterop": true,
        "noImplicitAny": true, //defaul value is false
        "moduleResolution": "node",
        "sourceMap": false,
        "outDir": "dist",
        "rootDir": ".",
        "baseUrl": ".",

        "paths": {
            "*": [
                "node_modules/*",
                "src/types/*"
            ]
        },

        "typeRoots": ["./src/types", "node_modules/@types"],
    
        
    },
    "include": [
        "src/**/*"
    ],

    "exclude": ["./src/types"]

}