# Server
PORT=4000

# Symbol REST node URL (required)
# Testnet example: https://sym-test-01.opening-line.jp:3001
# Mainnet: use appropriate Symbol mainnet node
URL=

# Symbol network
NETWORK_IDENTIFIER=TEST_NET

# Network parameters (defaults from Symbol testnet)
EPOCH_ADJUSTMENT=1667250467
MAX_FEE=97000
NETWORK_CURRENCY_MOSAIC_ID_STRING=72C0212E67A08BCE
NETWORK_CURRENCY_DIVISIBILITY=6
NETWORK_MINIMUM_LOCK_AMOUNT=10000000
NETWORK_NEMESIS_PRIVATE_KEY=

# Nemesis generation hash (for some operations)
# Testnet: 49D6E1CE276A85B70EAFE52349AACCA389302E7A9754BCF1221E79494FC665A4
nemesisGenerationHash=

# Encryption for /transaction/sendEncrypted (32 characters)
ENCRYPTION_KEY=
